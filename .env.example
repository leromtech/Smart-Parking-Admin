# Copy to .env (never commit .env). All values required for full functionality.
# Backend Laravel API base URL (used in src/boot/api.js:6)
VITE_API_URL=http://localhost:8000/api
# External frontend URL for customer/manager hard-redirect (used in src/scripts/auth.js:50)
VITE_FRONTEND_URL=http://localhost:5174
# Reverb websocket config (used in src/main.js:49-51; add SCHEME in prod per BUG_REPORT.md)
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Google Maps API key (used in src/scripts/map.js:10)
VITE_GOOGLE_MAP_API_KEY=
