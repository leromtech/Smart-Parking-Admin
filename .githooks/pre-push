#!/bin/sh
# Pre-push: lint + tests (when present) + build gate for Vue/Vite app.
# Bypass: SMART_PARKING_SKIP_HOOKS=1 git push  OR  git push --no-verify  OR  git config hooks.bypass true

if [ "$SMART_PARKING_SKIP_HOOKS" = "1" ]; then
  echo "[pre-push] skipped via SMART_PARKING_SKIP_HOOKS=1"
  exit 0
fi

if [ "$(git config --bool hooks.bypass 2>/dev/null)" = "true" ]; then
  echo "[pre-push] skipped via git config hooks.bypass=true"
  exit 0
fi

# ESLint (blocking when installed, skip when absent)
if npx --no-install eslint --version >/dev/null 2>&1; then
  echo "[pre-push] npm run lint"
  npm run lint || {
    echo "[pre-push] lint failed — fix or bypass with SMART_PARKING_SKIP_HOOKS=1 / --no-verify"
    exit 1
  }
else
  echo "[pre-push] eslint not installed, skipping lint (see PLAN.md Phase 2)"
fi

# Vitest (blocking when script + binary exist, skip otherwise)
if npm run | grep -qE '(^|\s)test(\s|$)' 2>/dev/null && npx --no-install vitest --version >/dev/null 2>&1; then
  echo "[pre-push] npm run test -- --run"
  npm run test -- --run || {
    echo "[pre-push] tests failed — fix or bypass with SMART_PARKING_SKIP_HOOKS=1 / --no-verify"
    exit 1
  }
else
  echo "[pre-push] vitest/test script absent, skipping tests (see PLAN.md Phase 2)"
fi

# Build gate (always blocking when node_modules present)
if [ ! -d "node_modules" ]; then
  echo "[pre-push] node_modules missing — run npm ci first; skipping build check"
  exit 0
fi

echo "[pre-push] npm run build"
npm run build || {
  echo "[pre-push] build failed — fix or bypass with SMART_PARKING_SKIP_HOOKS=1 / --no-verify"
  exit 1
}

exit 0
